<?xml version="1.0" encoding="utf-8"?>
<!--
  Alcyone talks to Multica over HTTPS only. Cleartext stays disabled so the
  shell can never be downgraded to an unencrypted connection.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
